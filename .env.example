# ── WhatsApp Service — Template de configuration ─────────────────────────────
# Copiez ce fichier : cp .env.example .env
# Remplissez les valeurs — NE JAMAIS commiter .env

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=production             # development | production

# ── Sécurité ──────────────────────────────────────────────────────────────────
# OBLIGATOIRE en production — le service refusera de démarrer sans elle
# Générer avec : openssl rand -hex 32
BRIDGE_API_KEY= 

# Origines CORS autorisées : * en dev, URL exacte en prod
CORS_ORIGIN=https://votre-domaine.com

# Clé de chiffrement AES-256 des sessions — OBLIGATOIRE en production
# Générer avec : openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whatsapp_service
DB_USER=root
DB_PASS=

# ── File d'attente ────────────────────────────────────────────────────────────
MESSAGE_DELAY_MS=1500           # Délai minimum entre deux envois (ms)
MESSAGE_DELAY_MAX_MS=3000       # Délai maximum — aléatoire entre min et max
MAX_RETRY_ATTEMPTS=3            # Tentatives avant statut 'failed'

# ── Dashboard ─────────────────────────────────────────────────────────────────
# false en production — exposer le dashboard expose le QR code
# Mettre true uniquement avec une protection nginx (basic auth)
ENABLE_DASHBOARD=false

# ── Alertes e-mail ────────────────────────────────────────────────────────────
# Laissez ALERT_EMAIL vide pour désactiver les alertes
ALERT_EMAIL=admin@votre-domaine.com
SMTP_HOST=smtp.votre-domaine.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=whatsapp-service@votre-domaine.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                  # debug | info | warn | error

# ── Firebase Authentication ───────────────────────────────────────────────────
# Obtenir depuis Firebase Console → Paramètres du projet → Comptes de service
# → Générer une nouvelle clé privée

# Option 1 (recommandée CI/CD) : coller le contenu JSON de la clé de service
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2 (dev local) : chemin vers le fichier JSON téléchargé
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ID du projet Firebase (optionnel — déduit depuis la clé de service)
# FIREBASE_PROJECT_ID=mon-projet-firebase

# ── Providers OAuth activés ───────────────────────────────────────────────────
# Activer dans Firebase Console → Authentication → Sign-in method :
#   - Google  : https://console.firebase.google.com/project/_/authentication/providers
#   - GitHub  : nécessite une OAuth App GitHub (https://github.com/settings/applications/new)
#               Callback URL Firebase : https://[PROJECT_ID].firebaseapp.com/__/auth/handler
