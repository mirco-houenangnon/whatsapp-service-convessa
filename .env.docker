# ── Convessa Backend — Variables Docker ──────────────────────────────────────
# Éditez ce fichier avant de lancer : docker compose up -d --build

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=production

# ── Sécurité (générer avec : openssl rand -hex 32) ────────────────────────────
BRIDGE_API_KEY=change_me_openssl_rand_hex_32
SESSION_ENCRYPTION_KEY=change_me_openssl_rand_hex_32

# ── CORS — URL(s) du frontend séparées par des virgules ───────────────────────
CORS_ORIGIN=http://localhost,https://votre-domaine.com,*.vercel.app

# ── Dashboard admin ───────────────────────────────────────────────────────────
ENABLE_DASHBOARD=true

# ── Base de données MySQL (hôte VPS via host.docker.internal) ─────────────────
# Assurez-vous que MySQL écoute sur 0.0.0.0 (pas seulement 127.0.0.1)
# et que l'utilisateur MySQL autorise les connexions depuis 172.x.x.x
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=convessa
DB_USER=convessa_user
DB_PASS=change_me_strong_password

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=whatsappservice-50e51
FIREBASE_SERVICE_ACCOUNT_PATH=./whatsappservice-50e51-firebase-adminsdk-fbsvc-d35a2c107b.json
FIREBASE_WEB_API_KEY=AIzaSyC1QO7iJdYlu6yRdFWV_LF9_lmw1ZjcZiA

# ── Admin JWT ──────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change_me_openssl_rand_hex_32

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Passerelles de paiement ───────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=sk_live_W-19lvwJismbypanXtNT1kJw
FEDAPAY_PUBLIC_KEY=pk_live_h39v70XIZwAr3BO6hq1YCXFN
FEDAPAY_ENV=live
FEDAPAY_CALLBACK_URL=https://votre-domaine.com/payment/callback

KKIAPAY_PRIVATE_KEY=VOTRE_CLE_PRIVEE_KKIAPAY
KKIAPAY_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_KKIAPAY
KKIAPAY_SECRET_KEY=VOTRE_SECRET_KKIAPAY
KKIAPAY_SANDBOX=false

FRONTEND_URL=https://votre-domaine.com

# ── File d'attente ────────────────────────────────────────────────────────────
