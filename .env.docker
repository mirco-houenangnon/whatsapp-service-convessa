# ── CORS — mettre le vrai domaine en production ───────────────────────────────
# Local :      CORS_ORIGIN=http://localhost:8080
# Production : CORS_ORIGIN=https://votre-domaine.com
CORS_ORIGIN=http://localhost:8080

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=convessa
DB_USER=root
DB_PASS=

# ── File d'attente ────────────────────────────────────────────────────────────
MESSAGE_DELAY_MS=1500
MESSAGE_DELAY_MAX_MS=3000
MAX_RETRY_ATTEMPTS=3

# ── Dashboard admin ───────────────────────────────────────────────────────────
ENABLE_DASHBOARD=true

# ── Alertes e-mail — laisser vide pour désactiver ────────────────────────────
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Chatbot IA (service interne, optionnel) ────────────────────────────────────
# Laisser vide si le service IA n'est pas déployé — le chatbot sera désactivé
INTERNAL_AI_SERVICE_KEY=
IA_SERVICE_URL=http://ia-service:8100

