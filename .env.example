# ── WhatsApp Service — Template de configuration ─────────────────────────────
# Copiez ce fichier : cp .env.example .env
# Remplissez les valeurs — NE JAMAIS commiter .env

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=production             # development | production

# ── Sécurité ──────────────────────────────────────────────────────────────────
# OBLIGATOIRE en production — le service refusera de démarrer sans elle
# Générer avec : openssl rand -hex 32
BRIDGE_API_KEY=

# Origines CORS autorisées : * en dev, URL exacte en prod
CORS_ORIGIN=https://votre-domaine.com

# Clé de chiffrement AES-256 des sessions — OBLIGATOIRE en production
# Générer avec : openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whatsapp_service
DB_USER=root
DB_PASS=

# ── File d'attente ────────────────────────────────────────────────────────────
MESSAGE_DELAY_MS=1500           # Délai minimum entre deux envois (ms)
MESSAGE_DELAY_MAX_MS=3000       # Délai maximum — aléatoire entre min et max
MAX_RETRY_ATTEMPTS=3            # Tentatives avant statut 'failed'

# ── Dashboard ─────────────────────────────────────────────────────────────────
# false en production — exposer le dashboard expose le QR code
# Mettre true uniquement avec une protection nginx (basic auth)
ENABLE_DASHBOARD=false

# ── Alertes e-mail ────────────────────────────────────────────────────────────
# Laissez ALERT_EMAIL vide pour désactiver les alertes
ALERT_EMAIL=admin@votre-domaine.com
SMTP_HOST=smtp.votre-domaine.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=whatsapp-service@votre-domaine.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                  # debug | info | warn | error
