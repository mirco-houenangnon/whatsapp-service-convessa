# ── Convessa Backend — Variables Docker ──────────────────────────────────────
# Ce fichier est versionné — il contient la configuration complète du projet.
# Après un git pull, lancez simplement : docker compose up -d --build
#
# Seules deux choses à adapter selon votre machine locale :
#   DB_USER  → votre utilisateur MySQL local
#   DB_PASS  → votre mot de passe MySQL local

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=production

# ── Sécurité ──────────────────────────────────────────────────────────────────
BRIDGE_API_KEY=c66428b5567a1142769bcd8a64808761505dbd6be86c691f376758afed704b01
SESSION_ENCRYPTION_KEY=d998ac7f9a4b0438505b9bb66f5c4dc6a350e8ab9b6c381a86532f669dc3589e
ADMIN_JWT_SECRET=convessa-admin-change-this-in-prod-openssl-rand-hex-32

# ── CORS — mettre le vrai domaine en production ───────────────────────────────
# Local :      CORS_ORIGIN=http://localhost:8080
# Production : CORS_ORIGIN=https://votre-domaine.com
CORS_ORIGIN=http://localhost:8080

# ── Base de données MySQL (hôte local via passerelle Docker) ──────────────────
# host.docker.internal pointe vers la machine hôte depuis le conteneur.
# → MySQL doit écouter sur 0.0.0.0 (pas seulement 127.0.0.1)
# → Adapter DB_USER et DB_PASS selon votre installation locale
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=convessa
DB_USER=root
DB_PASS=

# ── File d'attente ────────────────────────────────────────────────────────────
MESSAGE_DELAY_MS=1500
MESSAGE_DELAY_MAX_MS=3000
MAX_RETRY_ATTEMPTS=3

# ── Dashboard admin ───────────────────────────────────────────────────────────
ENABLE_DASHBOARD=true

# ── Alertes e-mail — laisser vide pour désactiver ────────────────────────────
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Service IA intégré (optionnel) ────────────────────────────────────────────
# Le service IA Python tourne dans le même conteneur que le backend Node.js.
# Ollama tourne comme conteneur Docker séparé (défini dans docker-compose.yml).
# Laisser OLLAMA_HOST vide désactive le chatbot — le backend démarre quand même.
INTERNAL_AI_SERVICE_KEY=0706e4239c879de6deb2c634205425273295c98ec1ccec9160051807d3fca79c
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
# Pour utiliser une API externe (Groq, OpenAI…) à la place d'Ollama :
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=votre_cle_api
# LLM_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ── Firebase Authentication ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=whatsappservice-50e51
FIREBASE_SERVICE_ACCOUNT_PATH=./whatsappservice-50e51-firebase-adminsdk-fbsvc-d35a2c107b.json
FIREBASE_WEB_API_KEY=AIzaSyC1QO7iJdYlu6yRdFWV_LF9_lmw1ZjcZiA

# ── Paiement FedaPay ──────────────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=sk_live_W-19lvwJismbypanXtNT1kJw
FEDAPAY_PUBLIC_KEY=pk_live_h39v70XIZwAr3BO6hq1YCXFN
FEDAPAY_ENV=live
# Local :      FEDAPAY_CALLBACK_URL=http://localhost:8080/payment/callback
# Production : FEDAPAY_CALLBACK_URL=https://votre-domaine.com/payment/callback
FEDAPAY_CALLBACK_URL=http://localhost:8080/payment/callback

# ── KKiaPay ───────────────────────────────────────────────────────────────────
KKIAPAY_PRIVATE_KEY=VOTRE_CLE_PRIVEE_KKIAPAY
KKIAPAY_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_KKIAPAY
KKIAPAY_SECRET_KEY=VOTRE_SECRET_KKIAPAY
KKIAPAY_SANDBOX=false

# ── URL Frontend ──────────────────────────────────────────────────────────────
# Local :      FRONTEND_URL=http://localhost:8080
# Production : FRONTEND_URL=https://votre-domaine.com
FRONTEND_URL=http://localhost:8080
