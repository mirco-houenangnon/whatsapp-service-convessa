# ── WhatsApp Service — Docker ─────────────────────────────────────────────────
# PRODUCTION — remplacer TOUTES les valeurs marquées TODO avant de déployer
# Générer les clés : openssl rand -hex 32

PORT=3005
NODE_ENV=production

# ── Sécurité — OBLIGATOIRE : changer ces valeurs ──────────────────────────────
BRIDGE_API_KEY=c66428b5567a1142769bcd8a64808761505dbd6be86c691f376758afed704b01
SESSION_ENCRYPTION_KEY=d998ac7f9a4b0438505b9bb66f5c4dc6a350e8ab9b6c381a86532f669dc3589e
