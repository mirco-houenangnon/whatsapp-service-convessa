# ─── WhatsApp Bridge Service — Template ──────────────────────────────────────
# Copiez ce fichier : cp .env.example .env
# Remplissez les valeurs — NE JAMAIS commiter .env

# Port d'écoute
# Doit correspondre à WHATSAPP_BRIDGE_URL dans le .env du backend
PORT=3005

# Environnement : local | production
NODE_ENV=production

# Clé API secrète — partagée avec le backend Laravel
# OBLIGATOIRE en production — le service refusera de démarrer sans elle
# Générer avec : openssl rand -hex 32
BRIDGE_API_KEY=

# Origines CORS autorisées
# local : *   |   production : URL exacte du backend/frontend
CORS_ORIGIN=https://votre-domaine.com

# Dashboard HTML (public/index.html) — permet de scanner le QR depuis un navigateur
# false en production par défaut (le dashboard expose le QR code)
# Mettre true SEULEMENT si vous protégez l'accès avec nginx + mot de passe
ENABLE_DASHBOARD=false
